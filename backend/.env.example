# ---- قاعدة البيانات ----
DATABASE_URL="postgresql://labs:labs@localhost:5432/labs"

# ---- الخادم ----
PORT=4000
CORS_ORIGIN="http://localhost:3000"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="12h"
STORAGE_DIR="./storage"

# ---- MQTT (يُستعمل فقط للأجهزة من نوع MQTT) ----
MQTT_URL="mqtt://localhost:1883"
MQTT_USERNAME=""
MQTT_PASSWORD=""

# ---- الجلسات عن بُعد ----
NO_SHOW_GRACE_SEC=120
REMINDER_MINUTES=10

# ---- البريد الإلكتروني (اختياري: إن تُرك فارغاً تُكتب الرسائل في السجل فقط) ----
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Virtual Labs <no-reply@labs.local>"

# ---- المنطقة الزمنية (ساعات فتح الجهاز + عرض المواعيد في الإشعارات) ----
APP_TIMEZONE="Africa/Casablanca"
